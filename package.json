{
  "name": "focuscode",
  "version": "1.2.0",
  "description": "macOS focus trainer — memorize a 4-digit code, recall it later",
  "main": "src/main.js",
  "scripts": {
    "start": "ELECTRON_RUN_AS_NODE='' electron .",
    "build": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis",
    "release": "electron-builder --mac dmg --win nsis --publish always"
  },
  "build": {
    "appId": "com.focuscode.app",
    "productName": "FocusCode",
    "files": [
      "src/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "nevidomyi",
      "repo": "focus"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "src/icon.icns",
      "target": "dmg",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "FocusCode",
      "icon": "src/icon.icns",
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "icon": "src/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
